# Скопируй в .env и подставь свои значения (.env в git не попадает)
# Ключ OpenAI — обязателен для ИИ-классификации и расшифровки видео
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Параметры базы данных (docker-compose поднимает Postgres сам)
POSTGRES_PASSWORD=devpass
POSTGRES_DB=gosanalitika

# Порты на хосте
WEB_PORT=8082
API_PORT=8092

# Первый администратор — создаётся автоматически при старте, если ещё не существует.
# Войди под ним, затем заведи остальных пользователей и смени этот пароль.
ADMIN_EMAIL=admin@example.kz
ADMIN_PASSWORD=change-me-please
# true только если приложение работает по HTTPS (защищённые cookie)
COOKIE_SECURE=false

# --- Межсайтовый деплой: фронт и бэк на РАЗНЫХ доменах (Vercel + Railway) ---
# На БЭКЕНДЕ (Railway) укажи origin фронта и включи cross-site cookie:
#   CORS_ORIGINS=https://your-frontend.vercel.app
#   COOKIE_SAMESITE=none      # требует COOKIE_SECURE=true
#   COOKIE_SECURE=true
# На ФРОНТЕНДЕ (Vercel) задаётся в его переменных окружения (не здесь):
#   VITE_API_URL=https://your-backend.up.railway.app

# --- Модели OpenAI (необязательно; по умолчанию whisper-1 / gpt-4o / gpt-4o-mini) ---
# OpenAI отключает whisper-1 26.02.2027, а снимки gpt-4o / gpt-4o-mini — 14.01.2027.
# Модели можно сменить здесь без правки кода.
# OPENAI_TRANSCRIBE_MODEL=whisper-1   # нужна поддержка verbose_json + таймкодов сегментов
# OPENAI_MODEL=gpt-4o                 # сопоставление вёрстки с видео и классификация
# OPENAI_MINI_MODEL=gpt-4o-mini       # разбивка на сюжеты и запасной классификатор
