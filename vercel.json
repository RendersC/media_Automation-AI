{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack pnpm install --ignore-scripts",
  "buildCommand": "corepack pnpm --filter @workspace/media-analytics build",
  "outputDirectory": "artifacts/media-analytics/dist/public",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
